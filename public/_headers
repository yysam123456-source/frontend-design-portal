/assets/*
  Cache-Control: public, max-age=31536000, immutable

/demo-assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Generated SEO pages (regenerated on every build)
/projects/*
  Cache-Control: public, max-age=3600

/categories/*
  Cache-Control: public, max-age=3600

/components/*
  Cache-Control: public, max-age=3600

# Brand asset; versioned by content, cheap to re-fetch daily
/og-image.png
  Cache-Control: public, max-age=86400

# Sitemaps & robots are re-read by Google frequently; keep them fresh
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
