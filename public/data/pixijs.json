    "description": "Planetary orbit simulation.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Orbit System - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Orbit System: a pulsing sun with planets on concentric orbits.\r\n  const cx = app.screen.width / 2, cy = app.screen.height / 2;\r\n  const sun = new PIXI.Graphics();\r\n  sun.circle(0, 0, 48); sun.fill({ color: 0xf7b731, alpha: 0.18 });\r\n  sun.circle(0, 0, 30); sun.fill({ color: 0xf7b731 });\r\n  sun.x = cx; sun.y = cy;\r\n  app.stage.addChild(sun);\r\n  const planets = [\r\n    { r: 75, size: 6, color: 0xff6b6b, speed: 0.03 },\r\n    { r: 125, size: 10, color: 0x4ecdc4, speed: 0.02 },\r\n    { r: 185, size: 14, color: 0x45b7d1, speed: 0.014 },\r\n    { r: 255, size: 8, color: 0xa55eea, speed: 0.009 },\r\n    { r: 325, size: 12, color: 0x26de81, speed: 0.006 }\r\n  ];\r\n  planets.forEach((p) => {\r\n    const ring = new PIXI.Graphics();\r\n    ring.circle(0, 0, p.r); ring.stroke({ width: 1, color: 0xffffff, alpha: 0.12 });\r\n    ring.x = cx; ring.y = cy; app.stage.addChild(ring);\r\n    const body = new PIXI.Graphics();\r\n    body.circle(0, 0, p.size); body.fill({ color: p.color }); body.stroke({ width: 1, color: 0xffffff, alpha: 0.3 });\r\n    app.stage.addChild(body);\r\n    p.body = body; p.angle = Math.random() * Math.PI * 2;\r\n  });\r\n  app.ticker.add((ticker) => {\r\n    sun.scale.set(1 + Math.sin(performance.now() / 400) * 0.05);\r\n    planets.forEach((p) => {\r\n      p.angle += p.speed * ticker.deltaTime;\r\n      p.body.x = cx + Math.cos(p.angle) * p.r;\r\n      p.body.y = cy + Math.sin(p.angle) * p.r;\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
