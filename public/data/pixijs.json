    "description": "Animated shapes moving in patterns.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Sprite Animation - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Sprite Animation: mixed shapes orbiting in layered lissajous patterns.\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea, 0x26de81];\r\n  const cx = app.screen.width / 2, cy = app.screen.height / 2;\r\n  const shapes = [];\r\n  for (let i = 0; i < 42; i++) {\r\n    const g = new PIXI.Graphics();\r\n    const size = 7 + Math.random() * 14;\r\n    const type = i % 3;\r\n    if (type === 0) g.circle(0, 0, size);\r\n    else if (type === 1) g.rect(-size, -size, size * 2, size * 2);\r\n    else g.poly([0, -size, size, size, -size, size]);\r\n    g.fill({ color: colors[i % colors.length], alpha: 0.8 });\r\n    app.stage.addChild(g);\r\n    shapes.push({ g, angle: (i / 42) * Math.PI * 2, radius: 70 + (i % 5) * 48, speed: 0.005 + (i % 5) * 0.002, rot: 0.02 + Math.random() * 0.03 });\r\n  }\r\n  app.ticker.add((ticker) => {\r\n    shapes.forEach((s) => {\r\n      s.angle += s.speed * ticker.deltaTime;\r\n      s.g.x = cx + Math.cos(s.angle) * s.radius;\r\n      s.g.y = cy + Math.sin(s.angle * 2) * s.radius * 0.55;\r\n      s.g.rotation += s.rot * ticker.deltaTime;\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
