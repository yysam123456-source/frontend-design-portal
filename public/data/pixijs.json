    "description": "Click to create expanding ripples.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Ripple Effect - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Ripple Effect: click anywhere to spawn expanding, fading rings.\r\n  const colors = [0x4ecdc4, 0x45b7d1, 0xa55eea, 0xff6b6b, 0xf7b731];\r\n  const ripples = [];\r\n  const container = new PIXI.Container();\r\n  app.stage.addChild(container);\r\n  const spawn = (x, y) => {\r\n    for (let i = 0; i < 3; i++) {\r\n      const g = new PIXI.Graphics();\r\n      g.x = x; g.y = y;\r\n      container.addChild(g);\r\n      ripples.push({ g, r: 1, max: 120 + Math.random() * 80, alpha: 1, delay: i * 6, color: colors[(ripples.length + i) % colors.length] });\r\n    }\r\n  };\r\n  app.stage.eventMode = 'static';\r\n  app.stage.hitArea = app.screen;\r\n  app.stage.on('pointerdown', (e) => spawn(e.global.x, e.global.y));\r\n  let autoT = 0;\r\n  app.ticker.add((ticker) => {\r\n    autoT += ticker.deltaTime;\r\n    if (autoT > 80) { autoT = 0; spawn(Math.random() * app.screen.width, Math.random() * app.screen.height); }\r\n    for (let i = ripples.length - 1; i >= 0; i--) {\r\n      const rp = ripples[i];\r\n      if (rp.delay > 0) { rp.delay -= ticker.deltaTime; continue; }\r\n      rp.r += 2.5 * ticker.deltaTime;\r\n      rp.alpha -= 0.012 * ticker.deltaTime;\r\n      rp.g.clear();\r\n      rp.g.circle(0, 0, rp.r);\r\n      rp.g.stroke({ width: 3, color: rp.color, alpha: Math.max(0, rp.alpha) });\r\n      if (rp.alpha <= 0 || rp.r > rp.max) { container.removeChild(rp.g); rp.g.destroy(); ripples.splice(i, 1); }\r\n    }\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
