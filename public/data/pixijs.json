    "description": "Animated text with various styles and fonts.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Text Rendering - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Text Rendering: animated labels with stroke + drop-shadow styles.\r\n  const labels = ['PIXI.JS', 'WebGL Power', 'Canvas API', 'Text Rendering', 'v8.19'];\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea];\r\n  const items = [];\r\n  labels.forEach((label, i) => {\r\n    const t = new PIXI.Text({\r\n      text: label,\r\n      style: {\r\n        fontFamily: 'Arial', fontSize: 46, fontWeight: 'bold', fill: colors[i],\r\n        stroke: { color: 0xffffff, width: 2, alpha: 0.25 },\r\n        dropShadow: { color: colors[i], blur: 10, distance: 6, alpha: 0.5 }\r\n      }\r\n    });\r\n    t.anchor.set(0.5);\r\n    t.x = app.screen.width / 2;\r\n    t.y = 90 + i * 95;\r\n    app.stage.addChild(t);\r\n    items.push({ t, base: t.y, phase: i * 0.6 });\r\n  });\r\n  app.ticker.add(() => {\r\n    const time = performance.now() / 1000;\r\n    items.forEach((it) => {\r\n      it.t.y = it.base + Math.sin(time * 2 + it.phase) * 12;\r\n      it.t.scale.x = 1 + Math.sin(time * 3 + it.phase) * 0.05;\r\n      it.t.scale.y = 1 + Math.cos(time * 3 + it.phase) * 0.05;\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
