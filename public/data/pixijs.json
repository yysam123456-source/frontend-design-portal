    "description": "Draws rotating polygons with PixiJS Graphics API.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Basic Graphics - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Basic Graphics: rotating polygons drawn with the PixiJS Graphics API.\r\n  const shapes = [];\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea, 0x26de81, 0xfd79a8, 0x6c5ce7];\r\n  for (let i = 0; i < 8; i++) {\r\n    const g = new PIXI.Graphics();\r\n    const sides = 3 + i;\r\n    const r = 48;\r\n    g.moveTo(0, -r);\r\n    for (let j = 1; j < sides; j++) {\r\n      const a = (j / sides) * Math.PI * 2 - Math.PI / 2;\r\n      g.lineTo(Math.cos(a) * r, Math.sin(a) * r);\r\n    }\r\n    g.closePath();\r\n    g.fill({ color: colors[i], alpha: 0.75 });\r\n    g.stroke({ width: 3, color: 0xffffff, alpha: 0.85 });\r\n    g.x = (app.screen.width / 9) * (i + 1);\r\n    g.y = app.screen.height / 2;\r\n    app.stage.addChild(g);\r\n    shapes.push({ g, speed: 0.006 + i * 0.004 });\r\n  }\r\n  app.ticker.add((ticker) => {\r\n    shapes.forEach((s) => { s.g.rotation += s.speed * ticker.deltaTime; });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
