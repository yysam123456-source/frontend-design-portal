    "description": "Shapes that morph between geometries.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Morphing Shapes - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Morphing Shapes: smooth interpolation between polygon + circle geometries.\r\n  const cx = app.screen.width / 2, cy = app.screen.height / 2;\r\n  const N = 64;\r\n  const genShape = (sides) => {\r\n    const arr = [];\r\n    for (let i = 0; i < N; i++) {\r\n      const a = (i / N) * Math.PI * 2;\r\n      if (sides < 3) { arr.push({ x: Math.cos(a) * 110, y: Math.sin(a) * 110 }); }\r\n      else {\r\n        const seg = Math.floor((i / N) * sides);\r\n        const a1 = (seg / sides) * Math.PI * 2 - Math.PI / 2;\r\n        const a2 = ((seg + 1) / sides) * Math.PI * 2 - Math.PI / 2;\r\n        const frac = ((i / N) * sides) % 1;\r\n        const x1 = Math.cos(a1) * 110, y1 = Math.sin(a1) * 110;\r\n        const x2 = Math.cos(a2) * 110, y2 = Math.sin(a2) * 110;\r\n        arr.push({ x: x1 + (x2 - x1) * frac, y: y1 + (y2 - y1) * frac });\r\n      }\r\n    }\r\n    return arr;\r\n  };\r\n  const shapeList = [3, 4, 5, 6, 8, 0].map(genShape);\r\n  const pts = shapeList[0].map((p) => ({ x: p.x, y: p.y }));\r\n  const g = new PIXI.Graphics();\r\n  g.x = cx; g.y = cy;\r\n  app.stage.addChild(g);\r\n  let cur = 0, prog = 0;\r\n  const draw = () => {\r\n    g.clear();\r\n    g.moveTo(pts[0].x, pts[0].y);\r\n    for (let i = 1; i < N; i++) g.lineTo(pts[i].x, pts[i].y);\r\n    g.closePath();\r\n    g.fill({ color: 0x4ecdc4, alpha: 0.35 });\r\n    g.stroke({ width: 3, color: 0xffffff, alpha: 0.85 });\r\n    for (let i = 0; i < N; i += 2) { g.circle(pts[i].x, pts[i].y, 3); g.fill({ color: 0xff6b6b }); }\r\n  };\r\n  app.ticker.add((ticker) => {\r\n    prog += ticker.deltaTime * 0.012;\r\n    if (prog >= 1) { prog = 0; cur = (cur + 1) % shapeList.length; }\r\n    const nxt = (cur + 1) % shapeList.length;\r\n    const e = prog * prog * (3 - 2 * prog);\r\n    for (let i = 0; i < N; i++) {\r\n      pts[i].x = shapeList[cur][i].x + (shapeList[nxt][i].x - shapeList[cur][i].x) * e;\r\n      pts[i].y = shapeList[cur][i].y + (shapeList[nxt][i].y - shapeList[cur][i].y) * e;\r\n    }\r\n    draw();\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
