    "description": "Showcases the v8.19 HTMLSource feature concept.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>HTML-in-Canvas - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; font-family: system-ui, sans-serif; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n    .notice { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 20; color: #4ecdc4; font-size: 13px; background: rgba(0,0,0,.5); padding: 7px 16px; border-radius: 20px; border: 1px solid rgba(78,205,196,.3); }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div class=\"notice\" id=\"notice\">PixiJS v8.19 HTMLSource - live DOM rendered into the canvas</div>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  document.getElementById('notice').textContent = 'HTML-in-Canvas fallback - PixiJS Graphics render';\r\n  const fallback = (n, x, y) => {\r\n    const c = new PIXI.Container(); c.x = x; c.y = y;\r\n    const g = new PIXI.Graphics();\r\n    g.roundRect(-120, -46, 240, 92, 14); g.fill({ color: 0x4ecdc4, alpha: 0.9 }); g.stroke({ width: 2, color: 0xffffff, alpha: 0.3 });\r\n    c.addChild(g);\r\n    [['HTMLSource #' + n, 11, -34], ['Hello PixiJS', 24, -18], ['Live DOM -> canvas texture', 12, 16]].forEach((item) => {\r\n      const tx = new PIXI.Text({ text: item[0], style: { fontFamily: 'system-ui', fontSize: item[1], fontWeight: item[1] > 20 ? '800' : 'normal', fill: 0x0f111a } });\r\n      tx.x = -104; tx.y = item[2]; c.addChild(tx);\r\n    });\r\n    app.stage.addChild(c);\r\n    return c;\r\n  };\r\n  const cards = [];\r\n  const pos = (i) => [180 + (i % 2) * 360, 220 + Math.floor(i / 2) * 220];\r\n  for (let i = 0; i < 4; i++) { const c = fallback(i + 1, pos(i)[0], pos(i)[1]); cards.push({ obj: c, baseY: c.y, phase: i * 0.6 }); }\r\n  app.ticker.add(() => {\r\n    const t = performance.now() / 1000;\r\n    cards.forEach((c) => { c.obj.y = c.baseY + Math.sin(t * 1.5 + c.phase) * 12; c.obj.rotation = Math.sin(t + c.phase) * 0.04; });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
