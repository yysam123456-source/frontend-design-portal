    "description": "Draggable shapes with physics.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Drag and Drop - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Drag & Drop: grab shapes, release them with throw velocity + gravity.\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea, 0x26de81];\r\n  const shapes = [];\r\n  let active = null, offX = 0, offY = 0, lastX = 0, lastY = 0;\r\n  app.stage.eventMode = 'static';\r\n  app.stage.hitArea = app.screen;\r\n  app.stage.sortableChildren = true;\r\n  for (let i = 0; i < 6; i++) {\r\n    const g = new PIXI.Graphics();\r\n    const r = 38;\r\n    if (i % 2 === 0) g.circle(0, 0, r); else g.poly([0, -r, r, r, -r, r]);\r\n    g.fill({ color: colors[i], alpha: 0.85 });\r\n    g.stroke({ width: 3, color: 0xffffff, alpha: 0.4 });\r\n    g.x = 130 + (i % 3) * 230;\r\n    g.y = 150 + Math.floor(i / 3) * 230;\r\n    g.eventMode = 'static'; g.cursor = 'grab';\r\n    g.on('pointerdown', (e) => {\r\n      active = g; offX = e.global.x - g.x; offY = e.global.y - g.y;\r\n      lastX = g.x; lastY = g.y; g.cursor = 'grabbing'; g.zIndex = 10;\r\n      e.stopPropagation();\r\n    });\r\n    app.stage.addChild(g);\r\n    shapes.push({ g, vx: 0, vy: 0 });\r\n  }\r\n  app.stage.on('pointermove', (e) => {\r\n    if (active) { lastX = active.x; lastY = active.y; active.x = e.global.x - offX; active.y = e.global.y - offY; }\r\n  });\r\n  const release = () => {\r\n    if (!active) return;\r\n    const s = shapes.find((sh) => sh.g === active);\r\n    if (s) { s.vx = (active.x - lastX) * 0.6; s.vy = (active.y - lastY) * 0.6; }\r\n    active.cursor = 'grab'; active = null;\r\n  };\r\n  app.stage.on('pointerup', release);\r\n  app.stage.on('pointerupoutside', release);\r\n  app.ticker.add((ticker) => {\r\n    shapes.forEach((s) => {\r\n      if (s.g === active) return;\r\n      s.vy += 0.35 * ticker.deltaTime;\r\n      s.g.x += s.vx * ticker.deltaTime; s.g.y += s.vy * ticker.deltaTime;\r\n      if (s.g.y > app.screen.height - 38) { s.g.y = app.screen.height - 38; s.vy *= -0.55; s.vx *= 0.9; }\r\n      if (s.g.x < 38) { s.g.x = 38; s.vx *= -0.7; }\r\n      if (s.g.x > app.screen.width - 38) { s.g.x = app.screen.width - 38; s.vx *= -0.7; }\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
