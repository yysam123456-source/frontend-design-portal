    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Color Filters - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Color Filters: ColorMatrixFilter applied to identical color swatches.\r\n  const setups = [\r\n    { name: 'Hue 90', apply: (f) => f.hue(90, false) },\r\n    { name: 'Saturate', apply: (f) => f.saturate(3, false) },\r\n    { name: 'Negative', apply: (f) => f.negative(false) },\r\n    { name: 'Sepia', apply: (f) => f.sepia(false) }\r\n  ];\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea];\r\n  const tiles = [];\r\n  for (let i = 0; i < 4; i++) {\r\n    const filter = new PIXI.ColorMatrixFilter();\r\n    setups[i].apply(filter);\r\n    const cont = new PIXI.Container();\r\n    cont.filters = [filter];\r\n    const g = new PIXI.Graphics();\r\n    for (let j = 0; j < 5; j++) { g.circle(30 + j * 52, 70, 20); g.fill({ color: colors[j] }); }\r\n    g.roundRect(15, 105, 270, 22, 11); g.fill({ color: 0xffffff, alpha: 0.85 });\r\n    cont.addChild(g);\r\n    const label = new PIXI.Text({ text: setups[i].name, style: { fontFamily: 'Arial', fontSize: 18, fontWeight: 'bold', fill: 0xffffff } });\r\n    label.x = 20; label.y = 12;\r\n    cont.addChild(label);\r\n    cont.x = 90 + (i % 2) * 350;\r\n    cont.y = 110 + Math.floor(i / 2) * 230;\r\n    app.stage.addChild(cont);\r\n    tiles.push({ cont, baseY: cont.y });\r\n  }\r\n  let tt = 0;\r\n  app.ticker.add((ticker) => {\r\n    tt += ticker.deltaTime * 0.03;\r\n    tiles.forEach((item, i) => { item.cont.y = item.baseY + Math.sin(tt + i) * 8; });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
