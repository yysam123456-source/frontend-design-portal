    "description": "200+ colored particles with mouse gravity interaction.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Particle System - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Particle System: 260 particles pulled toward the mouse by gravity.\r\n  const mouse = { x: app.screen.width / 2, y: app.screen.height / 2 };\r\n  app.stage.eventMode = 'static';\r\n  app.stage.hitArea = app.screen;\r\n  app.stage.on('pointermove', (e) => { mouse.x = e.global.x; mouse.y = e.global.y; });\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea];\r\n  const particles = [];\r\n  for (let i = 0; i < 260; i++) {\r\n    const g = new PIXI.Graphics();\r\n    g.circle(0, 0, 2 + Math.random() * 3);\r\n    g.fill({ color: colors[i % colors.length], alpha: 0.85 });\r\n    g.x = Math.random() * app.screen.width;\r\n    g.y = Math.random() * app.screen.height;\r\n    app.stage.addChild(g);\r\n    particles.push({ g, vx: 0, vy: 0 });\r\n  }\r\n  app.ticker.add((ticker) => {\r\n    particles.forEach((p) => {\r\n      const dx = mouse.x - p.g.x, dy = mouse.y - p.g.y;\r\n      const dist = Math.sqrt(dx * dx + dy * dy) || 1;\r\n      const force = Math.min(900 / (dist * dist), 0.6);\r\n      p.vx += (dx / dist) * force * ticker.deltaTime;\r\n      p.vy += (dy / dist) * force * ticker.deltaTime;\r\n      p.vx *= 0.94; p.vy *= 0.94;\r\n      p.g.x += p.vx; p.g.y += p.vy;\r\n      if (p.g.x < 0) p.g.x = app.screen.width;\r\n      if (p.g.x > app.screen.width) p.g.x = 0;\r\n      if (p.g.y < 0) p.g.y = app.screen.height;\r\n      if (p.g.y > app.screen.height) p.g.y = 0;\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
