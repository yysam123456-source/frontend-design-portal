    "description": "Clickable card grid with hover effects.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Interactive Cards - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Interactive Cards: grid of clickable cards with hover scale.\r\n  const cols = 5, rows = 3, cardW = 150, cardH = 100, gap = 18;\r\n  const colors = [0xff6b6b,0x4ecdc4,0x45b7d1,0xf7b731,0xa55eea,0x26de81,0xfd79a8,0x6c5ce7,0x00b894,0xe17055,0x0984e3,0xd63031,0xfab1a0,0x55efc4,0x74b9ff];\r\n  const totalW = cols * cardW + (cols - 1) * gap;\r\n  const totalH = rows * cardH + (rows - 1) * gap;\r\n  const startX = (app.screen.width - totalW) / 2;\r\n  const startY = (app.screen.height - totalH) / 2;\r\n  const cards = [];\r\n  app.stage.sortableChildren = true;\r\n  for (let r = 0; r < rows; r++) {\r\n    for (let c = 0; c < cols; c++) {\r\n      const idx = r * cols + c;\r\n      const g = new PIXI.Graphics();\r\n      g.roundRect(0, 0, cardW, cardH, 12);\r\n      g.fill({ color: colors[idx % colors.length], alpha: 0.85 });\r\n      g.stroke({ width: 2, color: 0xffffff, alpha: 0.2 });\r\n      const label = new PIXI.Text({ text: 'Card ' + (idx + 1), style: { fontFamily: 'Arial', fontSize: 18, fill: 0xffffff } });\r\n      label.anchor.set(0.5); label.x = cardW / 2; label.y = cardH / 2;\r\n      g.addChild(label);\r\n      g.pivot.set(cardW / 2, cardH / 2);\r\n      g.x = startX + c * (cardW + gap) + cardW / 2;\r\n      g.y = startY + r * (cardH + gap) + cardH / 2;\r\n      g.eventMode = 'static'; g.cursor = 'pointer';\r\n      const card = { g, target: 1 };\r\n      g.on('pointerover', () => { card.target = 1.1; g.zIndex = 10; });\r\n      g.on('pointerout', () => { card.target = 1; g.zIndex = 0; });\r\n      g.on('pointerdown', () => { card.target = 0.92; });\r\n      g.on('pointerup', () => { card.target = 1.1; });\r\n      app.stage.addChild(g);\r\n      cards.push(card);\r\n    }\r\n  }\r\n  app.ticker.add(() => {\r\n    cards.forEach((c) => {\r\n      const s = c.g.scale.x + (c.target - c.g.scale.x) * 0.15;\r\n      c.g.scale.set(s);\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
  {
