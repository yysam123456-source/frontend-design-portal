    "description": "Physics-based bouncing balls with gravity.",
    "codeSnippet": {
      "language": "html",
      "source": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Bouncing Balls - PixiJS</title>\r\n  <style>\r\n    html, body { margin: 0; padding: 0; background: #0f111a; overflow: hidden; }\r\n    #canvas-container { width: 100vw; height: 100vh; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <div id=\"canvas-container\"></div>\r\n  <script src=\"/vendor/pixi.min.js\"></script>\r\n  <script>\r\n(async () => {\r\n  const app = new PIXI.Application();\r\n  await app.init({ resizeTo: window, background: '#0f111a', antialias: true, preference: 'webgl' });\r\n  document.getElementById('canvas-container').appendChild(app.canvas);\r\n  // Bouncing Balls: gravity + damping physics on a handful of spheres.\r\n  const gravity = 0.45, damping = 0.82;\r\n  const colors = [0xff6b6b, 0x4ecdc4, 0x45b7d1, 0xf7b731, 0xa55eea, 0x26de81, 0xfd79a8];\r\n  const balls = [];\r\n  for (let i = 0; i < 16; i++) {\r\n    const r = 14 + Math.random() * 26;\r\n    const g = new PIXI.Graphics();\r\n    g.circle(0, 0, r);\r\n    g.fill({ color: colors[i % colors.length], alpha: 0.9 });\r\n    g.stroke({ width: 2, color: 0xffffff, alpha: 0.35 });\r\n    g.x = Math.random() * (app.screen.width - r * 2) + r;\r\n    g.y = Math.random() * 180;\r\n    app.stage.addChild(g);\r\n    balls.push({ g, vx: (Math.random() - 0.5) * 7, vy: 0, r });\r\n  }\r\n  app.ticker.add((ticker) => {\r\n    balls.forEach((b) => {\r\n      b.vy += gravity * ticker.deltaTime;\r\n      b.g.x += b.vx * ticker.deltaTime;\r\n      b.g.y += b.vy * ticker.deltaTime;\r\n      if (b.g.y + b.r > app.screen.height) {\r\n        b.g.y = app.screen.height - b.r; b.vy *= -damping; b.vx *= 0.98;\r\n      }\r\n      if (b.g.x - b.r < 0) { b.g.x = b.r; b.vx *= -damping; }\r\n      if (b.g.x + b.r > app.screen.width) { b.g.x = app.screen.width - b.r; b.vx *= -damping; }\r\n    });\r\n  });\r\n})();\r\n  </script>\r\n</body>\r\n</html>"
    }
  },
